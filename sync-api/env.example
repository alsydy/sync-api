# ============================================================================
# MalyMax Professional Sync API - Environment Variables
# ============================================================================
# انسخ هذا الملف إلى .env واملأ القيم المناسبة
# ============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=malymax_prod
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional: Database Connection Pool Settings
# DB_MAX_CONNECTIONS=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=2000

# ============================================================================
# ملاحظات:
# - تأكد من إنشاء قاعدة البيانات PostgreSQL قبل تشغيل الخادم
# - استخدم كلمة مرور قوية في بيئة الإنتاج
# - غير JWT_SECRET في بيئة الإنتاج
# - لا ترفع ملف .env إلى Git
# ============================================================================

